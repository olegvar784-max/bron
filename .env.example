# Пример конфигурации. Скопируйте в .env и задайте значения. Файл .env в репозиторий не добавляется.
PORT=8080
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bron
DB_USER=postgres
DB_PASSWORD=<пароль_БД>
JWT_SECRET=<длинная_случайная_строка>
JWT_TTL=2h
SEED_PASSWORD=<пароль_демонстрационных_учётных_записей>
